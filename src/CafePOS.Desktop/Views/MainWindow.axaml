<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CafePOS.Desktop.ViewModels"
        xmlns:models="using:CafePOS.Application.Models"
        x:Class="CafePOS.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Gloria Café · Punto de venta" Width="1440" Height="860" MinWidth="1180" MinHeight="700"
        WindowStartupLocation="CenterScreen">
 <Grid RowDefinitions="76,*" Background="#F4F6F5">
  <Border Background="#18352B" Padding="28,0">
   <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <Border Width="38" Height="38" Background="#DFAF4D" CornerRadius="19"><TextBlock Text="C" FontSize="22" FontWeight="Bold" Foreground="#18352B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel><TextBlock Text="Gloria Café" FontSize="24" FontWeight="Bold" Foreground="White"/><TextBlock Text="Punto de venta" FontSize="12" Foreground="#B8D2C3"/><TextBlock Text="{Binding CurrentUserRole}" FontSize="11" Foreground="#DFAF4D"/></StackPanel>
    <Button Classes="secondary" Content="Actualizar ahora" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding HasAvailableUpdate}" Margin="18,0,0,0" VerticalAlignment="Center"/>
   </StackPanel>
  </Border>
  <TabControl Grid.Row="1" TabStripPlacement="Left" Background="#F4F6F5" Padding="18">
   <TabItem Header="Ventas">
    <Grid ColumnDefinitions="*,430" RowDefinitions="Auto,*" ColumnSpacing="20">
     <StackPanel Grid.ColumnSpan="2" Margin="4,0,4,18"><TextBlock Text="Nueva venta" FontSize="28" FontWeight="Bold" Foreground="#1F2933"/><TextBlock Text="Selecciona productos disponibles para agregar a la orden." Foreground="#667085"/></StackPanel>
     <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="20">
      <Grid RowDefinitions="Auto,Auto,*">
       <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Catálogo" FontSize="20" FontWeight="Bold"/><TextBlock Text="Todos los productos activos están disponibles para venta." Foreground="#667085"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Products.Count, StringFormat='{}{0} productos'}" VerticalAlignment="Center" Foreground="#2D6A4F"/></Grid>
       <WrapPanel Grid.Row="1" Margin="0,18,0,6">
        <Button Classes="secondary" Content="Bebidas Frías" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.ColdBeverages}"/>
        <Button Classes="secondary" Content="Bebidas Calientes" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.HotBeverages}"/>
        <Button Classes="secondary" Content="Comida" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.Food}"/>
        <Button Classes="secondary" Content="Postres" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.Desserts}"/>
        <Button Classes="secondary" Content="Combos" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.Combos}"/>
        <Button Classes="secondary" Content="Extras" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.Extras}"/>
        <Button Classes="secondary" Content="Notas" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.Notes}"/>
       </WrapPanel>
       <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
        <Grid>
         <ItemsControl ItemsSource="{Binding Products}" IsVisible="{Binding IsProductSection}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><Button Classes="secondary" Width="184" Height="124" Margin="0,0,12,12" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Command="{Binding $parent[Window].DataContext.AddProductCommand}" CommandParameter="{Binding}"><Grid RowDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Category}" FontSize="11" Foreground="#667085"/><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="{Binding Price, StringFormat='MXN {0:N2}'}" Foreground="#2D6A4F" FontSize="16" FontWeight="Bold"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         <Border IsVisible="{Binding IsNotesSection}" Background="#F8FAF9" CornerRadius="10" Padding="24"><StackPanel Spacing="14" MaxWidth="620"><TextBlock Text="Notas de la orden" FontSize="21" FontWeight="Bold"/><TextBlock Text="Escribe indicaciones para preparación o entrega." Foreground="#667085"/><TextBox Text="{Binding Comments}" AcceptsReturn="True" MinHeight="130" TextWrapping="Wrap"/></StackPanel></Border>
        </Grid>
       </ScrollViewer>
      </Grid>
     </Border>
     <Border Grid.Column="1" Grid.Row="1" Background="#F8F7FC" CornerRadius="14" Padding="22">
      <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
       <StackPanel><TextBlock Text="Resumen de orden" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding Cart.Count, StringFormat='{}{0} líneas'}" Foreground="#667085"/></StackPanel>
       <ListBox Grid.Row="1" ItemsSource="{Binding Cart}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:CartLine"><Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,10"><Grid ColumnDefinitions="*,Auto,34,Auto"><StackPanel><TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Product.Category}" FontSize="12" Foreground="#667085"/><TextBlock Text="{Binding Product.Price, StringFormat='MXN {0:N2} c/u'}" FontSize="12" Foreground="#667085"/></StackPanel><Button Grid.Column="1" Classes="secondary" Content="−" Command="{Binding $parent[Window].DataContext.DecrementCommand}" CommandParameter="{Binding}" Padding="8,3"/><TextBlock Grid.Column="2" Text="{Binding Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="3" Classes="secondary" Content="+" Command="{Binding $parent[Window].DataContext.IncrementCommand}" CommandParameter="{Binding}" Padding="8,3"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
       <StackPanel Grid.Row="2" Spacing="8"><TextBox Watermark="Nombre del cliente" Text="{Binding CustomerName}"/><TextBox Watermark="Teléfono del cliente (10-15 dígitos)" Text="{Binding CustomerPhone}"/><ComboBox ItemsSource="{Binding DeliveryOptions}" SelectedItem="{Binding SelectedDeliveryOption}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Opción de entrega"/><TextBox IsVisible="{Binding RequiresDeliveryAddress}" Watermark="Dirección de entrega" Text="{Binding DeliveryAddress}"/><CheckBox IsVisible="{Binding RequiresDeliveryAddress}" Content="Efectivo contra entrega" IsChecked="{Binding CashOnDelivery}"/></StackPanel>
       <Border Grid.Row="3" Background="#4F659D" CornerRadius="16" Padding="18,15"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Total a pagar" FontSize="12" Foreground="White"/><TextBlock Text="{Binding Total, StringFormat='MXN {0:N2}'}" FontSize="27" FontWeight="Bold" Foreground="White"/><TextBlock Text="{Binding TotalItems, StringFormat='{}{0} productos'}" FontSize="12" Foreground="White"/></StackPanel><StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><Button Content="GUARDAR ORDEN" Command="{Binding ConfirmOrderCommand}" Background="White" Foreground="#4F659D"/><Button Classes="secondary" Content="Nueva" Command="{Binding NewOrderCommand}"/></StackPanel></Grid></Border>
      </Grid>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="Historial">
    <Grid Margin="4" ColumnDefinitions="3*,2*" RowDefinitions="Auto,*" ColumnSpacing="18">
     <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,18"><TextBlock Text="Historial de ventas" FontSize="28" FontWeight="Bold"/><TextBlock Text="Consulta órdenes, clientes y estado de pago." Foreground="#667085"/></StackPanel>
     <Grid Grid.Row="1" RowDefinitions="Auto,*"><Grid ColumnDefinitions="150,150,*,Auto,Auto" ColumnSpacing="8"><TextBox Watermark="Desde yyyy-MM-dd" Text="{Binding HistoryFromText}"/><TextBox Grid.Column="1" Watermark="Hasta yyyy-MM-dd" Text="{Binding HistoryToText}"/><TextBox Grid.Column="2" Watermark="Buscar cliente, teléfono, orden o producto" Text="{Binding HistorySearch}"/><Button Grid.Column="3" Classes="secondary" Content="Hoy" Command="{Binding ShowTodayHistoryCommand}"/><Button Grid.Column="4" Classes="primary" Content="Actualizar" Command="{Binding RefreshHistoryCommand}"/></Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistoryOrder}" Margin="0,12,0,0" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding DailyNumber, StringFormat='Orden #{0}'}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerName}"/><TextBlock Text="{Binding CustomerPhone}" FontSize="12" Foreground="#667085"/><TextBlock Text="{Binding Total, StringFormat='MXN {0:N2}'}" FontWeight="SemiBold" Foreground="#2D6A4F"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" Foreground="#4F659D" FontWeight="SemiBold"/><TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="12" Foreground="#667085"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid>
     <Border Grid.Column="1" Grid.Row="1" Background="White" CornerRadius="14" Padding="20">
      <ScrollViewer>
       <StackPanel Spacing="10">
        <TextBlock Text="Detalle de la orden" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding SelectedOrderTitle}" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SelectedOrderSummary}" TextWrapping="Wrap" Foreground="#667085"/>
        <WrapPanel>
         <Button Classes="secondary" Content="Imprimir cocina" Command="{Binding PrintKitchenCommand}" IsEnabled="{Binding CanPrintSelectedOrder}"/>
         <Button Classes="secondary" Content="Imprimir cliente" Command="{Binding PrintCustomerCommand}" IsEnabled="{Binding CanPrintSelectedOrder}"/>
        </WrapPanel>
        <Separator/>
        <TextBlock Text="Cliente" FontWeight="SemiBold"/>
        <TextBox Watermark="Nombre" Text="{Binding SelectedHistoryOrder.CustomerName}"/>
        <TextBox Watermark="Teléfono" Text="{Binding SelectedHistoryOrder.CustomerPhone}"/>
        <TextBox Watermark="Dirección" Text="{Binding SelectedHistoryOrder.DeliveryAddress}"/>
        <TextBox Watermark="Comentarios" Text="{Binding SelectedHistoryOrder.Comments}" AcceptsReturn="True" MinHeight="55"/>
        <Button Classes="secondary" Content="Guardar datos de orden" Command="{Binding SaveSelectedOrderCommand}" IsEnabled="{Binding CanEditSelectedOrder}"/>
        <Separator/>
        <TextBlock Text="Partidas" FontWeight="SemiBold"/>
        <ItemsControl ItemsSource="{Binding SelectedOrderItems}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ProductName}" Margin="0,3"/><TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat='MXN {0:N2}'}" Margin="8,3"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{Binding SelectedHistoryOrder.DeliveryOptionName}" FontSize="12" Foreground="#667085"/>
        <Separator/>
        <TextBlock Text="Pago" FontWeight="SemiBold"/>
        <TextBlock Text="Liquida la orden completa con un solo método." Foreground="#667085"/>
        <TextBlock Text="{Binding SelectedPaymentBalance, StringFormat='Total pendiente: MXN {0:N2}'}" Foreground="#B54708"/>
        <WrapPanel><Button Classes="primary" Content="Pagar total efectivo" Command="{Binding PayTotalCashCommand}" IsEnabled="{Binding CanEditSelectedOrder}"/><Button Classes="primary" Content="Pagar total tarjeta" Command="{Binding PayTotalCardCommand}" IsEnabled="{Binding CanEditSelectedOrder}"/></WrapPanel>
        <TextBox Watermark="Motivo de cancelación" Text="{Binding CancellationReason}" Margin="0,12,0,0"/>
        <Button Classes="danger" Content="Cancelar orden" Command="{Binding CancelSelectedOrderCommand}" IsEnabled="{Binding CanCancelSelectedOrder}"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="Movimientos">
    <Grid Margin="4" ColumnDefinitions="*,*" ColumnSpacing="18"><Border Background="White" CornerRadius="14" Padding="24"><StackPanel Spacing="14"><TextBlock Text="Nueva transacción manual" FontSize="20" FontWeight="Bold"/><TextBox Watermark="Concepto" Text="{Binding ManualTransactionConcept}"/><TextBox Watermark="Monto" Text="{Binding ManualTransactionAmount}"/><ComboBox ItemsSource="{Binding ManualTransactionTypes}" SelectedItem="{Binding SelectedManualTransactionType}" DisplayMemberBinding="{Binding Name}"/><Button Classes="primary" Content="Guardar transacción" Command="{Binding SaveManualTransactionCommand}" HorizontalAlignment="Right"/></StackPanel></Border>
     <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="24"><Grid RowDefinitions="Auto,*"><TextBlock Text="Historial de transacciones" FontSize="28" FontWeight="Bold"/><ListBox Grid.Row="1" ItemsSource="{Binding ManualTransactions}" BorderThickness="0" Margin="0,16,0,0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,10"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Concept}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Type}" Foreground="#667085"/><TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="12" Foreground="#667085"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Amount, StringFormat='MXN {0:N2}'}" FontWeight="Bold"/><Button Classes="danger" Content="Eliminar" Command="{Binding $parent[Window].DataContext.DeleteManualTransactionCommand}" CommandParameter="{Binding}" Padding="8,3"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
    </Grid>
   </TabItem>
   <TabItem Header="Reversas">
    <Grid Margin="4" ColumnDefinitions="360,*" ColumnSpacing="18">
     <Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Revertir movimiento manual" FontSize="20" FontWeight="Bold"/><TextBlock Text="La reversa crea un contramovimiento; nunca elimina el registro original." TextWrapping="Wrap" Foreground="#667085"/><TextBox Watermark="Motivo obligatorio de reversa" Text="{Binding ManualReversalReason}"/></StackPanel></Border>
     <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20"><ListBox ItemsSource="{Binding ManualTransactions}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="0,5"><StackPanel><TextBlock Text="{Binding Concept}" FontWeight="SemiBold"/><TextBlock Text="{Binding TypeLabel}" Foreground="#667085"/><TextBlock Text="{Binding Reason}" FontSize="12" Foreground="#667085"/></StackPanel><Button Grid.Column="1" Classes="danger" Content="Revertir" Command="{Binding $parent[Window].DataContext.DeleteManualTransactionCommand}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
    </Grid>
   </TabItem>
   <TabItem Header="Caja">
    <ScrollViewer Margin="4"><StackPanel Spacing="18"><TextBlock Text="Caja" FontSize="28" FontWeight="Bold"/><Grid ColumnDefinitions="180,Auto,Auto" ColumnSpacing="8"><TextBox Watermark="Fecha yyyy-MM-dd" Text="{Binding CashDateText}"/><Button Grid.Column="1" Classes="secondary" Content="Actualizar" Command="{Binding RefreshCashReportCommand}"/><Button Grid.Column="2" Classes="primary" Content="Hoy" Command="{Binding ShowTodayCashCommand}"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="18"><Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="5"><TextBlock Text="Órdenes" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CashReport.Orders, StringFormat='Órdenes: {0}'}"/><TextBlock Text="{Binding CashReport.OutstandingOrders, StringFormat='Pendiente: MXN {0:N2}'}"/></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="5"><TextBlock Text="Cobros" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CashReport.CashOrders, StringFormat='Efectivo: MXN {0:N2}'}"/><TextBlock Text="{Binding CashReport.CardOrders, StringFormat='Tarjeta: MXN {0:N2}'}"/></StackPanel></Border><Border Grid.Column="2" Background="#EEF6F1" CornerRadius="14" Padding="20"><StackPanel Spacing="5"><TextBlock Text="Totales" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CashReport.ManualIncome, StringFormat='Ingresos manuales: MXN {0:N2}'}"/><TextBlock Text="{Binding CashReport.ManualExpenses, StringFormat='Gastos: MXN {0:N2}'}"/><TextBlock Text="{Binding CashReport.TotalCash, StringFormat='Efectivo: MXN {0:N2}'}" FontWeight="Bold"/><TextBlock Text="{Binding CashReport.TotalInCaja, StringFormat='Total registrado: MXN {0:N2}'}" FontWeight="Bold"/></StackPanel></Border></Grid><Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="8"><TextBlock Text="Ventas por categoría" FontSize="20" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding CashReport.CategorySales}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18"><TextBlock Text="{Binding Category}"/><TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}"/><TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat='MXN {0:N2}'}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Indicadores" IsVisible="{Binding IsAdmin}">
    <ScrollViewer Margin="4"><StackPanel Spacing="14">
     <Grid ColumnDefinitions="180,180,Auto" ColumnSpacing="8"><TextBox Watermark="Desde yyyy-MM-dd" Text="{Binding MetricsFromText}"/><TextBox Grid.Column="1" Watermark="Hasta yyyy-MM-dd" Text="{Binding MetricsToText}"/><Button Grid.Column="2" Classes="primary" Content="Actualizar" Command="{Binding RefreshMetricsCommand}"/></Grid>
     <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
      <Border Background="White" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Facturado"/><TextBlock Text="{Binding Metrics.InvoicedSales, StringFormat='MXN {0:N2}'}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
      <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Cobrado"/><TextBlock Text="{Binding Metrics.CollectedPayments, StringFormat='MXN {0:N2}'}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
      <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Por cobrar"/><TextBlock Text="{Binding Metrics.OutstandingBalance, StringFormat='MXN {0:N2}'}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
      <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Ticket / entregas"/><TextBlock Text="{Binding Metrics.AverageTicket, StringFormat='MXN {0:N2}'}"/><TextBlock Text="{Binding Metrics.DeliveryRevenue, StringFormat='Entrega MXN {0:N2}'}"/></StackPanel></Border>
     </Grid>
     <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
      <Border Background="White" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="Comparación periodo previo" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding Metrics.Comparison.OrdersChange, StringFormat='Órdenes: {0:+#;-#;0}'}"/><TextBlock Text="{Binding Metrics.Comparison.InvoicedSalesChange, StringFormat='Facturado: MXN {0:+#;-#;0}'}"/><TextBlock Text="{Binding Metrics.Comparison.AverageTicketChange, StringFormat='Ticket: MXN {0:+#;-#;0}'}"/></StackPanel></Border>
      <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="Tendencia diaria" FontSize="18" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Metrics.Trend}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10"><TextBlock Text="{Binding BusinessDate}"/><TextBlock Grid.Column="1" Text="{Binding InvoicedSales, StringFormat='Fac. {0:N2}'}"/><TextBlock Grid.Column="2" Text="{Binding CollectedPayments, StringFormat='Cob. {0:N2}'}"/><TextBlock Grid.Column="3" Text="{Binding OutstandingBalance, StringFormat='Pend. {0:N2}'}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
     </Grid>
     <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
      <Border Background="White" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="Categorías: mayor / menor" FontSize="18" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Metrics.TopCategories}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Category}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Menor" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Metrics.BottomCategories}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Category}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
     </Grid>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Admin" IsVisible="{Binding IsAdmin}">
    <Grid Margin="4"><StackPanel IsVisible="{Binding IsAdminHome}" Spacing="16" MaxWidth="1120"><TextBlock Text="Panel de administración" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/><Button Classes="secondary" Command="{Binding OpenAdminProductsCommand}" HorizontalContentAlignment="Stretch" Padding="24"><StackPanel><TextBlock Text="Menú, productos y entregas" FontSize="18" FontWeight="Bold"/><TextBlock Text="Administra productos genéricos y opciones de entrega." Foreground="#667085"/></StackPanel></Button><Button Classes="secondary" Content="Crear respaldo local" Command="{Binding BackupCommand}" HorizontalAlignment="Left"/>
      <Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Impresora térmica USB de 58 mm" FontSize="20" FontWeight="Bold"/><TextBlock Text="Use la impresora 58-VII-U instalada en Windows (ESC/POS, USB, 384 puntos por línea)." Foreground="#667085"/><Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8"><TextBlock Text="Impresora única" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding SelectedPrinter}"/><TextBlock Grid.Row="1" Text="Impresión automática" VerticalAlignment="Center"/><CheckBox Grid.Row="1" Grid.Column="1" Content="Comanda al guardar" IsChecked="{Binding AutoPrintKitchen}"/><CheckBox Grid.Row="2" Grid.Column="1" Content="Ticket al cobrar" IsChecked="{Binding AutoPrintCustomer}"/></Grid><WrapPanel><Button Classes="primary" Content="Guardar configuración" Command="{Binding SavePrinterSettingsCommand}"/><Button Classes="secondary" Content="Actualizar lista" Command="{Binding RefreshPrintersCommand}"/></WrapPanel></StackPanel></Border></StackPanel>
     <ScrollViewer IsVisible="{Binding IsAdminProducts}"><StackPanel Spacing="16" MaxWidth="1120"><Grid ColumnDefinitions="Auto,*"><Button Classes="secondary" Content="← Panel" Command="{Binding CloseAdminProductsCommand}"/><TextBlock Grid.Column="1" Text="Menú y opciones de entrega" FontSize="28" FontWeight="Bold" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid><Grid ColumnDefinitions="400,*" ColumnSpacing="18"><Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Producto" FontSize="20" FontWeight="Bold"/><TextBox Watermark="Nombre" Text="{Binding AdminProductName}"/><ComboBox ItemsSource="{Binding ProductCategories}" SelectedItem="{Binding SelectedAdminProductCategory}" DisplayMemberBinding="{Binding Name}"/><TextBox Watermark="Precio" Text="{Binding AdminProductPrice}"/><WrapPanel><Button Classes="primary" Content="Guardar producto" Command="{Binding SaveAdminProductCommand}"/><Button Classes="secondary" Content="Nuevo" Command="{Binding NewAdminProductCommand}"/></WrapPanel><Separator/><TextBlock Text="Opción de entrega" FontSize="20" FontWeight="Bold"/><TextBox Watermark="Nombre" Text="{Binding AdminDeliveryName}"/><ComboBox ItemsSource="{Binding DeliveryTypes}" SelectedItem="{Binding SelectedAdminDeliveryType}" DisplayMemberBinding="{Binding Name}"/><TextBox Watermark="Tarifa" Text="{Binding AdminDeliveryFee}"/><WrapPanel><Button Classes="primary" Content="Guardar entrega" Command="{Binding SaveAdminDeliveryOptionCommand}"/><Button Classes="secondary" Content="Nueva" Command="{Binding NewAdminDeliveryOptionCommand}"/></WrapPanel></StackPanel></Border><StackPanel Grid.Column="1" Spacing="18"><Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Productos" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Width="180" ItemsSource="{Binding AdminProductFilters}" SelectedItem="{Binding SelectedAdminProductFilter}" DisplayMemberBinding="{Binding Name}"/></Grid><ListBox ItemsSource="{Binding FilteredAdminProducts}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,10"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" FontSize="12" Foreground="#667085"/><TextBlock Text="{Binding Price, StringFormat='MXN {0:N2}'}"/></StackPanel><Button Grid.Column="1" Classes="secondary" Content="Editar" Command="{Binding $parent[Window].DataContext.EditAdminProductCommand}" CommandParameter="{Binding}"/><Button Grid.Column="2" Classes="danger" Content="Desactivar" Command="{Binding $parent[Window].DataContext.DeactivateAdminProductCommand}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border><Border Background="White" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Opciones de entrega" FontSize="20" FontWeight="Bold"/><ListBox ItemsSource="{Binding AdminDeliveryOptions}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,10"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Type}"/><TextBlock Text="{Binding Fee, StringFormat='MXN {0:N2}'}"/></StackPanel><Button Grid.Column="1" Classes="secondary" Content="Editar" Command="{Binding $parent[Window].DataContext.EditAdminDeliveryOptionCommand}" CommandParameter="{Binding}"/><Button Grid.Column="2" Classes="danger" Content="Desactivar" Command="{Binding $parent[Window].DataContext.DeactivateAdminDeliveryOptionCommand}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></StackPanel></Grid></StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,30,16" Background="#1F2933" CornerRadius="8" Padding="14,8"><TextBlock Text="{Binding StatusMessage}" Foreground="White"/></Border>
 </Grid>
</Window>
