<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CafePOS.Desktop.ViewModels"
        xmlns:models="using:CafePOS.Application.Models"
        x:Class="CafePOS.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CafePOS" Width="1440" Height="860" MinWidth="1180" MinHeight="700"
        WindowStartupLocation="CenterScreen">
 <Grid RowDefinitions="76,*" Background="#F4F6F5">
  <Border Background="#18352B" Padding="28,0">
   <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <Border Width="38" Height="38" Background="#DFAF4D" CornerRadius="19"><TextBlock Text="C" FontSize="22" FontWeight="Bold" Foreground="#18352B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel><TextBlock Text="CafePOS" FontSize="24" FontWeight="Bold" Foreground="White"/><TextBlock Text="Punto de venta para cafetería" FontSize="12" Foreground="#B8D2C3"/><TextBlock Text="{Binding CurrentUserRole}" FontSize="11" Foreground="#DFAF4D"/></StackPanel>
    <Button Classes="secondary" Content="Actualizar ahora" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding HasAvailableUpdate}" Margin="18,0,0,0" VerticalAlignment="Center"/>
   </StackPanel>
  </Border>
  <TabControl Grid.Row="1" TabStripPlacement="Left" Background="#F4F6F5" Padding="18">
   <TabItem Header="Ventas">
    <Grid ColumnDefinitions="*,430" RowDefinitions="Auto,*" ColumnSpacing="20">
     <StackPanel Grid.ColumnSpan="2" Margin="4,0,4,18"><TextBlock Text="Nueva venta" FontSize="28" FontWeight="Bold" Foreground="#1F2933"/><TextBlock Text="Selecciona productos disponibles para agregar a la orden." Foreground="#667085"/></StackPanel>
     <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="20">
      <Grid RowDefinitions="Auto,Auto,*">
       <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Catálogo" FontSize="20" FontWeight="Bold"/><TextBlock Text="Los productos sin existencias no se muestran." Foreground="#667085"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Products.Count, StringFormat='{}{0} productos'}" VerticalAlignment="Center" Foreground="#2D6A4F"/></Grid>
       <WrapPanel Grid.Row="1" Margin="0,18,0,6">
        <Button Classes="secondary" Content="Café" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.Coffee}"/>
        <Button Classes="secondary" Content="Bebidas" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.Beverages}"/>
        <Button Classes="secondary" Content="Comida" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.Food}"/>
        <Button Classes="secondary" Content="Postres" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.Desserts}"/>
        <Button Classes="secondary" Content="Extras" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.Extras}"/>
        <Button Classes="secondary" Content="Notas" Command="{Binding SelectCatalogSectionCommand}" CommandParameter="{x:Static models:CatalogSection.Notes}"/>
       </WrapPanel>
       <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
        <Grid>
         <ItemsControl ItemsSource="{Binding Products}" IsVisible="{Binding IsProductSection}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><Button Classes="secondary" Width="184" Height="124" Margin="0,0,12,12" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Command="{Binding $parent[Window].DataContext.AddProductCommand}" CommandParameter="{Binding}"><Grid RowDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Category}" FontSize="11" Foreground="#667085"/><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding StockQuantity, StringFormat='Existencia: {0}'}" FontSize="12" Foreground="#667085"/></StackPanel><TextBlock Grid.Row="1" Text="{Binding Price, StringFormat='MXN {0:N2}'}" Foreground="#2D6A4F" FontSize="16" FontWeight="Bold"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         <Border IsVisible="{Binding IsNotesSection}" Background="#F8FAF9" CornerRadius="10" Padding="24"><StackPanel Spacing="14" MaxWidth="620"><TextBlock Text="Notas de la orden" FontSize="21" FontWeight="Bold"/><TextBlock Text="Escribe indicaciones para preparación o entrega." Foreground="#667085"/><TextBox Text="{Binding Comments}" AcceptsReturn="True" MinHeight="130" TextWrapping="Wrap"/></StackPanel></Border>
        </Grid>
       </ScrollViewer>
      </Grid>
     </Border>
     <Border Grid.Column="1" Grid.Row="1" Background="#F8F7FC" CornerRadius="14" Padding="22">
      <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
       <StackPanel><TextBlock Text="Resumen de orden" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding Cart.Count, StringFormat='{}{0} líneas'}" Foreground="#667085"/></StackPanel>
       <ListBox Grid.Row="1" ItemsSource="{Binding Cart}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:CartLine"><Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,10"><Grid ColumnDefinitions="*,Auto,34,Auto"><StackPanel><TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Product.Category}" FontSize="12" Foreground="#667085"/><TextBlock Text="{Binding Product.Price, StringFormat='MXN {0:N2} c/u'}" FontSize="12" Foreground="#667085"/></StackPanel><Button Grid.Column="1" Classes="secondary" Content="−" Command="{Binding $parent[Window].DataContext.DecrementCommand}" CommandParameter="{Binding}" Padding="8,3"/><TextBlock Grid.Column="2" Text="{Binding Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="3" Classes="secondary" Content="+" Command="{Binding $parent[Window].DataContext.IncrementCommand}" CommandParameter="{Binding}" Padding="8,3"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
       <StackPanel Grid.Row="2" Spacing="8"><TextBox Watermark="Nombre del cliente" Text="{Binding CustomerName}"/><TextBox Watermark="Teléfono del cliente (10-15 dígitos)" Text="{Binding CustomerPhone}"/><ComboBox ItemsSource="{Binding DeliveryOptions}" SelectedItem="{Binding SelectedDeliveryOption}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Opción de entrega"/><TextBox IsVisible="{Binding RequiresDeliveryAddress}" Watermark="Dirección de entrega" Text="{Binding DeliveryAddress}"/><CheckBox IsVisible="{Binding RequiresDeliveryAddress}" Content="Efectivo contra entrega" IsChecked="{Binding CashOnDelivery}"/></StackPanel>
       <Border Grid.Row="3" Background="#4F659D" CornerRadius="16" Padding="18,15"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Total a pagar" FontSize="12" Foreground="White"/><TextBlock Text="{Binding Total, StringFormat='MXN {0:N2}'}" FontSize="27" FontWeight="Bold" Foreground="White"/><TextBlock Text="{Binding TotalItems, StringFormat='{}{0} productos'}" FontSize="12" Foreground="White"/></StackPanel><StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><Button Content="GUARDAR ORDEN" Command="{Binding ConfirmOrderCommand}" Background="White" Foreground="#4F659D"/><Button Classes="secondary" Content="Nueva" Command="{Binding NewOrderCommand}"/></StackPanel></Grid></Border>
      </Grid>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="Historial">
    <Grid Margin="4" ColumnDefinitions="3*,2*" RowDefinitions="Auto,*" ColumnSpacing="18">
     <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,18"><TextBlock Text="Historial de ventas" FontSize="28" FontWeight="Bold"/><TextBlock Text="Consulta órdenes, clientes y desglose de pagos." Foreground="#667085"/></StackPanel>
     <Grid Grid.Row="1" RowDefinitions="Auto,*"><Grid ColumnDefinitions="150,150,*,Auto,Auto" ColumnSpacing="8"><TextBox Watermark="Desde yyyy-MM-dd" Text="{Binding HistoryFromText}"/><TextBox Grid.Column="1" Watermark="Hasta yyyy-MM-dd" Text="{Binding HistoryToText}"/><TextBox Grid.Column="2" Watermark="Buscar cliente, teléfono, orden o producto" Text="{Binding HistorySearch}"/><Button Grid.Column="3" Classes="secondary" Content="Hoy" Command="{Binding ShowTodayHistoryCommand}"/><Button Grid.Column="4" Classes="primary" Content="Actualizar" Command="{Binding RefreshHistoryCommand}"/></Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistoryOrder}" Margin="0,12,0,0" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding DailyNumber, StringFormat='Orden #{0}'}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerName}"/><TextBlock Text="{Binding CustomerPhone}" FontSize="12" Foreground="#667085"/><TextBlock Text="{Binding Total, StringFormat='MXN {0:N2}'}" FontWeight="SemiBold" Foreground="#2D6A4F"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" Foreground="#4F659D" FontWeight="SemiBold"/><TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="12" Foreground="#667085"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid>
     <Border Grid.Column="1" Grid.Row="1" Background="White" CornerRadius="14" Padding="20"><ScrollViewer><StackPanel Spacing="10"><TextBlock Text="Detalle de la orden" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding SelectedOrderTitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedOrderSummary}" TextWrapping="Wrap" Foreground="#667085"/><Separator/><TextBlock Text="Cliente" FontWeight="SemiBold"/><TextBox Watermark="Nombre" Text="{Binding SelectedHistoryOrder.CustomerName}"/><TextBox Watermark="Teléfono" Text="{Binding SelectedHistoryOrder.CustomerPhone}"/><TextBox Watermark="Dirección" Text="{Binding SelectedHistoryOrder.DeliveryAddress}"/><TextBox Watermark="Comentarios" Text="{Binding SelectedHistoryOrder.Comments}" AcceptsReturn="True" MinHeight="55"/><Button Classes="secondary" Content="Guardar datos de orden" Command="{Binding SaveSelectedOrderCommand}" IsEnabled="{Binding CanEditSelectedOrder}"/><Separator/><TextBlock Text="Partidas" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding SelectedOrderItems}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ProductName}" Margin="0,3"/><TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat='MXN {0:N2}'}" Margin="8,3"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding SelectedHistoryOrder.DeliveryOptionName}" FontSize="12" Foreground="#667085"/><Separator/><TextBlock Text="Desglose de pago" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedPaymentBalance, StringFormat='Saldo pendiente: MXN {0:N2}'}" Foreground="#B54708"/><ListBox ItemsSource="{Binding PaymentBreakdown}" SelectedItem="{Binding SelectedPayment}" MaxHeight="125"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Method}" FontWeight="SemiBold"/><TextBlock Text="{Binding Reference}" FontSize="12" Foreground="#667085"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='MXN {0:N2}'}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" DisplayMemberBinding="{Binding Name}" IsEnabled="{Binding CanEditSelectedOrder}"/><TextBox Watermark="Monto" Text="{Binding PaymentAmount}" IsEnabled="{Binding CanEditSelectedOrder}"/><TextBox Watermark="Referencia (obligatoria para transferencia)" Text="{Binding PaymentReference}" IsEnabled="{Binding CanEditSelectedOrder}"/><WrapPanel><Button Classes="primary" Content="Agregar" Command="{Binding AddPaymentCommand}" IsEnabled="{Binding CanEditSelectedOrder}"/><Button Classes="secondary" Content="Editar seleccionado" Command="{Binding UpdatePaymentCommand}" IsEnabled="{Binding CanEditSelectedOrder}"/><Button Classes="secondary" Content="Reemplazar todo" Command="{Binding ReplacePaymentBreakdownCommand}" IsEnabled="{Binding CanEditSelectedOrder}"/><Button Classes="danger" Content="Quitar seleccionado" Command="{Binding RemovePaymentCommand}" IsEnabled="{Binding CanEditSelectedOrder}"/><Button Classes="danger" Content="Limpiar pagos" Command="{Binding ClearPaymentBreakdownCommand}" IsEnabled="{Binding CanEditSelectedOrder}"/></WrapPanel><TextBox Watermark="Motivo de cancelación" Text="{Binding CancellationReason}" Margin="0,12,0,0"/><Button Classes="danger" Content="Cancelar orden y devolver inventario" Command="{Binding CancelSelectedOrderCommand}" IsEnabled="{Binding CanCancelSelectedOrder}"/></StackPanel></ScrollViewer></Border>
    </Grid>
   </TabItem>
   <TabItem Header="Cobros">
    <Grid Margin="4" ColumnDefinitions="3*,2*" ColumnSpacing="18">
     <Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="{Binding SelectedOrderTitle}" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding SelectedOrderSummary}" TextWrapping="Wrap"/><TextBlock Text="Ajustar pagos crea reversas auditables; no se eliminan cobros." Foreground="#667085"/><ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" DisplayMemberBinding="{Binding Name}" IsEnabled="{Binding CanEditSelectedOrder}"/><TextBox Watermark="Monto" Text="{Binding PaymentAmount}" IsEnabled="{Binding CanEditSelectedOrder}"/><TextBox Watermark="Referencia (obligatoria para transferencia)" Text="{Binding PaymentReference}" IsEnabled="{Binding CanEditSelectedOrder}"/><TextBox Watermark="Motivo de ajuste (obligatorio si ya hay cobros)" Text="{Binding PaymentAdjustmentReason}" IsEnabled="{Binding CanEditSelectedOrder}"/><WrapPanel><Button Classes="primary" Content="Agregar cobro" Command="{Binding AddPaymentCommand}" IsEnabled="{Binding CanEditSelectedOrder}"/><Button Classes="secondary" Content="Editar" Command="{Binding UpdatePaymentCommand}" IsEnabled="{Binding CanEditSelectedOrder}"/><Button Classes="danger" Content="Quitar" Command="{Binding RemovePaymentCommand}" IsEnabled="{Binding CanEditSelectedOrder}"/></WrapPanel><TextBlock Text="Cobros vigentes" FontWeight="Bold"/><ListBox ItemsSource="{Binding PaymentBreakdown}" SelectedItem="{Binding SelectedPayment}"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Method}"/><TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='MXN {0:N2}'}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
     <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Auditoría de pagos" FontSize="20" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding PaymentAudit}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock Text="{Binding Kind}" FontWeight="Bold"/><TextBlock Text="{Binding Amount, StringFormat='MXN {0:N2}'}"/><TextBlock Text="{Binding Reason}" Foreground="#667085"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </Grid>
   </TabItem>
   <TabItem Header="Entregas">
    <Grid Margin="4" ColumnDefinitions="3*,2*" ColumnSpacing="18">
     <StackPanel>
      <TextBlock Text="Seguimiento de entregas" FontSize="28" FontWeight="Bold"/>
      <TextBlock Text="Seleccione una orden de entrega desde Historial y actualice aquí el estado, repartidor y compromiso." Foreground="#667085" Margin="0,0,0,14"/>
      <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistoryOrder}" BorderThickness="0">
       <ListBox.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding DailyNumber, StringFormat='Orden #{0}'}" FontWeight="Bold"/><TextBlock Text="{Binding CustomerName}"/><TextBlock Text="{Binding DeliveryAddress}" TextWrapping="Wrap"/><TextBlock Text="{Binding DeliveryStatus}" Foreground="#4F659D"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </StackPanel>
     <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20">
      <StackPanel Spacing="10">
       <TextBlock Text="{Binding SelectedOrderTitle}" FontSize="20" FontWeight="Bold"/>
       <TextBlock Text="{Binding SelectedHistoryOrder.CustomerPhone}"/>
       <ComboBox ItemsSource="{Binding DeliveryStatuses}" SelectedItem="{Binding SelectedDeliveryStatus}" DisplayMemberBinding="{Binding Name}" IsEnabled="{Binding CanUpdateSelectedDelivery}"/>
       <TextBox Watermark="Repartidor" Text="{Binding SelectedRiderName}" IsEnabled="{Binding CanUpdateSelectedDelivery}"/>
       <TextBox Watermark="Prometida yyyy-MM-dd HH:mm" Text="{Binding SelectedPromisedAtText}" IsEnabled="{Binding CanUpdateSelectedDelivery}"/>
       <CheckBox Content="Efectivo contra entrega" IsChecked="{Binding SelectedCashOnDelivery}" IsEnabled="{Binding CanUpdateSelectedDelivery}"/>
       <Button Classes="primary" Content="Guardar seguimiento" Command="{Binding UpdateSelectedDeliveryCommand}" IsEnabled="{Binding CanUpdateSelectedDelivery}"/>
      </StackPanel>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="Movimientos">
    <Grid Margin="4" ColumnDefinitions="*,*" ColumnSpacing="18"><Border Background="White" CornerRadius="14" Padding="24"><StackPanel Spacing="14"><TextBlock Text="Nueva transacción manual" FontSize="20" FontWeight="Bold"/><TextBox Watermark="Concepto" Text="{Binding ManualTransactionConcept}"/><TextBox Watermark="Monto" Text="{Binding ManualTransactionAmount}"/><ComboBox ItemsSource="{Binding ManualTransactionTypes}" SelectedItem="{Binding SelectedManualTransactionType}" DisplayMemberBinding="{Binding Name}"/><Button Classes="primary" Content="Guardar transacción" Command="{Binding SaveManualTransactionCommand}" HorizontalAlignment="Right"/></StackPanel></Border>
     <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="24"><Grid RowDefinitions="Auto,*"><TextBlock Text="Historial de transacciones" FontSize="28" FontWeight="Bold"/><ListBox Grid.Row="1" ItemsSource="{Binding ManualTransactions}" BorderThickness="0" Margin="0,16,0,0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,10"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Concept}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Type}" Foreground="#667085"/><TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="12" Foreground="#667085"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Amount, StringFormat='MXN {0:N2}'}" FontWeight="Bold"/><Button Classes="danger" Content="Eliminar" Command="{Binding $parent[Window].DataContext.DeleteManualTransactionCommand}" CommandParameter="{Binding}" Padding="8,3"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
    </Grid>
   </TabItem>
   <TabItem Header="Reversas">
    <Grid Margin="4" ColumnDefinitions="360,*" ColumnSpacing="18">
     <Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Revertir movimiento manual" FontSize="20" FontWeight="Bold"/><TextBlock Text="La reversa crea un contramovimiento; nunca elimina el registro original." TextWrapping="Wrap" Foreground="#667085"/><TextBox Watermark="Motivo obligatorio de reversa" Text="{Binding ManualReversalReason}"/></StackPanel></Border>
     <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20"><ListBox ItemsSource="{Binding ManualTransactions}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="0,5"><StackPanel><TextBlock Text="{Binding Concept}" FontWeight="SemiBold"/><TextBlock Text="{Binding TypeLabel}" Foreground="#667085"/><TextBlock Text="{Binding Reason}" FontSize="12" Foreground="#667085"/></StackPanel><Button Grid.Column="1" Classes="danger" Content="Revertir" Command="{Binding $parent[Window].DataContext.DeleteManualTransactionCommand}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
    </Grid>
   </TabItem>
   <TabItem Header="Caja">
    <ScrollViewer Margin="4"><StackPanel Spacing="18"><TextBlock Text="Caja" FontSize="28" FontWeight="Bold"/><Grid ColumnDefinitions="180,Auto,Auto" ColumnSpacing="8"><TextBox Watermark="Fecha yyyy-MM-dd" Text="{Binding CashDateText}"/><Button Grid.Column="1" Classes="secondary" Content="Actualizar" Command="{Binding RefreshCashReportCommand}"/><Button Grid.Column="2" Classes="primary" Content="Hoy" Command="{Binding ShowTodayCashCommand}"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="18"><Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="5"><TextBlock Text="Órdenes" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CashReport.Orders, StringFormat='Órdenes: {0}'}"/><TextBlock Text="{Binding CashReport.OutstandingOrders, StringFormat='Pendiente: MXN {0:N2}'}"/></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="5"><TextBlock Text="Cobros" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CashReport.CashOrders, StringFormat='Efectivo: MXN {0:N2}'}"/><TextBlock Text="{Binding CashReport.TransferOrders, StringFormat='Transferencia: MXN {0:N2}'}"/><TextBlock Text="{Binding CashReport.CardOrders, StringFormat='Tarjeta: MXN {0:N2}'}"/></StackPanel></Border><Border Grid.Column="2" Background="#EEF6F1" CornerRadius="14" Padding="20"><StackPanel Spacing="5"><TextBlock Text="Totales" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CashReport.ManualIncome, StringFormat='Ingresos manuales: MXN {0:N2}'}"/><TextBlock Text="{Binding CashReport.ManualExpenses, StringFormat='Gastos: MXN {0:N2}'}"/><TextBlock Text="{Binding CashReport.TotalCash, StringFormat='Efectivo: MXN {0:N2}'}" FontWeight="Bold"/><TextBlock Text="{Binding CashReport.TotalInCaja, StringFormat='Total registrado: MXN {0:N2}'}" FontWeight="Bold"/></StackPanel></Border></Grid><Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="8"><TextBlock Text="Ventas por categoría" FontSize="20" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding CashReport.CategorySales}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18"><TextBlock Text="{Binding Category}"/><TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}"/><TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat='MXN {0:N2}'}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Stock" IsVisible="{Binding IsAdmin}">
    <Grid Margin="4" ColumnDefinitions="380,*" ColumnSpacing="18">
     <Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Entrada, conteo o ajuste" FontSize="20" FontWeight="Bold"/><TextBox Watermark="Fecha efectiva yyyy-MM-dd" Text="{Binding InventoryDateText}"/><ComboBox ItemsSource="{Binding InventoryProducts}" SelectedItem="{Binding SelectedInventoryProduct}" DisplayMemberBinding="{Binding Name}"/><ComboBox ItemsSource="{Binding AdjustmentTypes}" SelectedItem="{Binding SelectedAdjustmentType}" DisplayMemberBinding="{Binding Name}"/><TextBox Watermark="Cantidad (conteo = existencia física)" Text="{Binding InventoryAdjustmentQuantity}"/><TextBox Watermark="Motivo obligatorio" Text="{Binding InventoryAdjustmentReason}"/><TextBox Watermark="Proveedor (entrada)" Text="{Binding InventorySupplier}"/><TextBox Watermark="Referencia (entrada)" Text="{Binding InventoryReference}"/><Button Classes="primary" Content="Registrar movimiento auditado" Command="{Binding SaveInventoryAdjustmentCommand}"/><Button Classes="secondary" Content="Actualizar" Command="{Binding RefreshInventoryCommand}"/></StackPanel></Border>
     <StackPanel Grid.Column="1" Spacing="18"><Border Background="White" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Alertas / existencias" FontSize="20" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding InventoryProducts}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding IsLowStock, StringFormat='Alerta baja: {0}'}" Foreground="#B54708"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StockQuantity}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Background="White" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Rastro inmutable del día" FontSize="20" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding InventoryMovements}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding ProductName}" FontWeight="Bold"/><TextBlock Text="{Binding Type}"/><TextBlock Text="{Binding Reason}"/><TextBlock Text="{Binding Supplier}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Indicadores" IsVisible="{Binding IsAdmin}">
    <ScrollViewer Margin="4"><StackPanel Spacing="14">
     <Grid ColumnDefinitions="180,180,Auto" ColumnSpacing="8"><TextBox Watermark="Desde yyyy-MM-dd" Text="{Binding MetricsFromText}"/><TextBox Grid.Column="1" Watermark="Hasta yyyy-MM-dd" Text="{Binding MetricsToText}"/><Button Grid.Column="2" Classes="primary" Content="Actualizar" Command="{Binding RefreshMetricsCommand}"/></Grid>
     <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
      <Border Background="White" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Facturado"/><TextBlock Text="{Binding Metrics.InvoicedSales, StringFormat='MXN {0:N2}'}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
      <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Cobrado"/><TextBlock Text="{Binding Metrics.CollectedPayments, StringFormat='MXN {0:N2}'}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
      <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Por cobrar"/><TextBlock Text="{Binding Metrics.OutstandingBalance, StringFormat='MXN {0:N2}'}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
      <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Ticket / entregas"/><TextBlock Text="{Binding Metrics.AverageTicket, StringFormat='MXN {0:N2}'}"/><TextBlock Text="{Binding Metrics.DeliveryRevenue, StringFormat='Entrega MXN {0:N2}'}"/></StackPanel></Border>
     </Grid>
     <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
      <Border Background="White" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="Comparación periodo previo" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding Metrics.Comparison.OrdersChange, StringFormat='Órdenes: {0:+#;-#;0}'}"/><TextBlock Text="{Binding Metrics.Comparison.InvoicedSalesChange, StringFormat='Facturado: MXN {0:+#;-#;0}'}"/><TextBlock Text="{Binding Metrics.Comparison.AverageTicketChange, StringFormat='Ticket: MXN {0:+#;-#;0}'}"/></StackPanel></Border>
      <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="Tendencia diaria" FontSize="18" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Metrics.Trend}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10"><TextBlock Text="{Binding BusinessDate}"/><TextBlock Grid.Column="1" Text="{Binding InvoicedSales, StringFormat='Fac. {0:N2}'}"/><TextBlock Grid.Column="2" Text="{Binding CollectedPayments, StringFormat='Cob. {0:N2}'}"/><TextBlock Grid.Column="3" Text="{Binding OutstandingBalance, StringFormat='Pend. {0:N2}'}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
     </Grid>
     <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
      <Border Background="White" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="Categorías: mayor / menor" FontSize="18" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Metrics.TopCategories}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Category}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Menor" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Metrics.BottomCategories}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Category}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="Alertas y consumo" FontSize="18" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Metrics.LowStockAlerts}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Metrics.StockSignals.Consumed, StringFormat='Ventas: {0}'}"/><TextBlock Text="{Binding Metrics.StockSignals.Waste, StringFormat='Merma: {0}'}"/><TextBlock Text="{Binding Metrics.StockSignals.Corrected, StringFormat='Correcciones: {0}'}"/></StackPanel></Border>
     </Grid>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Admin" IsVisible="{Binding IsAdmin}">
    <Grid Margin="4"><StackPanel IsVisible="{Binding IsAdminHome}" Spacing="16" MaxWidth="1120"><TextBlock Text="Panel de administración" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/><Button Classes="secondary" Command="{Binding OpenAdminProductsCommand}" HorizontalContentAlignment="Stretch" Padding="24"><StackPanel><TextBlock Text="Menú, productos y entregas" FontSize="18" FontWeight="Bold"/><TextBlock Text="Administra productos genéricos y opciones de entrega." Foreground="#667085"/></StackPanel></Button><Button Classes="secondary" Command="{Binding OpenAdminInventoryCommand}" HorizontalContentAlignment="Stretch" Padding="24"><StackPanel><TextBlock Text="Control de inventario" FontSize="18" FontWeight="Bold"/><TextBlock Text="Registra producción, ajustes y consulta movimientos diarios." Foreground="#667085"/></StackPanel></Button><Button Classes="secondary" Command="{Binding OpenAdminMetricsCommand}" HorizontalContentAlignment="Stretch" Padding="24"><StackPanel><TextBlock Text="Métricas y análisis" FontSize="18" FontWeight="Bold"/><TextBlock Text="Comparativos, categorías, alertas y consumo de existencias." Foreground="#667085"/></StackPanel></Button><Button Classes="secondary" Content="Crear respaldo local" Command="{Binding BackupCommand}" HorizontalAlignment="Left"/></StackPanel>
     <ScrollViewer IsVisible="{Binding IsAdminProducts}"><StackPanel Spacing="16" MaxWidth="1120"><Grid ColumnDefinitions="Auto,*"><Button Classes="secondary" Content="← Panel" Command="{Binding CloseAdminProductsCommand}"/><TextBlock Grid.Column="1" Text="Menú y opciones de entrega" FontSize="28" FontWeight="Bold" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid><Grid ColumnDefinitions="400,*" ColumnSpacing="18"><Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Producto" FontSize="20" FontWeight="Bold"/><TextBox Watermark="Nombre" Text="{Binding AdminProductName}"/><ComboBox ItemsSource="{Binding ProductCategories}" SelectedItem="{Binding SelectedAdminProductCategory}" DisplayMemberBinding="{Binding Name}"/><TextBox Watermark="Precio" Text="{Binding AdminProductPrice}"/><TextBox Watermark="Existencia inicial (solo nuevo)" Text="{Binding AdminInitialStock}"/><TextBox Watermark="Alerta de existencias bajas" Text="{Binding AdminLowStockThreshold}"/><WrapPanel><Button Classes="primary" Content="Guardar producto" Command="{Binding SaveAdminProductCommand}"/><Button Classes="secondary" Content="Nuevo" Command="{Binding NewAdminProductCommand}"/></WrapPanel><Separator/><TextBlock Text="Opción de entrega" FontSize="20" FontWeight="Bold"/><TextBox Watermark="Nombre" Text="{Binding AdminDeliveryName}"/><ComboBox ItemsSource="{Binding DeliveryTypes}" SelectedItem="{Binding SelectedAdminDeliveryType}" DisplayMemberBinding="{Binding Name}"/><TextBox Watermark="Tarifa" Text="{Binding AdminDeliveryFee}"/><WrapPanel><Button Classes="primary" Content="Guardar entrega" Command="{Binding SaveAdminDeliveryOptionCommand}"/><Button Classes="secondary" Content="Nueva" Command="{Binding NewAdminDeliveryOptionCommand}"/></WrapPanel></StackPanel></Border><StackPanel Grid.Column="1" Spacing="18"><Border Background="White" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Productos" FontSize="20" FontWeight="Bold"/><ListBox ItemsSource="{Binding AdminProducts}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,10"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" FontSize="12" Foreground="#667085"/><TextBlock Text="{Binding Price, StringFormat='MXN {0:N2}'}"/><TextBlock Text="{Binding StockQuantity, StringFormat='Existencia: {0}'}" FontSize="12"/></StackPanel><Button Grid.Column="1" Classes="secondary" Content="Editar" Command="{Binding $parent[Window].DataContext.EditAdminProductCommand}" CommandParameter="{Binding}"/><Button Grid.Column="2" Classes="danger" Content="Desactivar" Command="{Binding $parent[Window].DataContext.DeactivateAdminProductCommand}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border><Border Background="White" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Opciones de entrega" FontSize="20" FontWeight="Bold"/><ListBox ItemsSource="{Binding AdminDeliveryOptions}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,10"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Type}"/><TextBlock Text="{Binding Fee, StringFormat='MXN {0:N2}'}"/></StackPanel><Button Grid.Column="1" Classes="secondary" Content="Editar" Command="{Binding $parent[Window].DataContext.EditAdminDeliveryOptionCommand}" CommandParameter="{Binding}"/><Button Grid.Column="2" Classes="danger" Content="Desactivar" Command="{Binding $parent[Window].DataContext.DeactivateAdminDeliveryOptionCommand}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></StackPanel></Grid></StackPanel></ScrollViewer>
     <ScrollViewer IsVisible="{Binding IsAdminInventory}"><StackPanel Spacing="16" MaxWidth="1120"><Grid ColumnDefinitions="Auto,*"><Button Classes="secondary" Content="← Panel" Command="{Binding CloseAdminInventoryCommand}"/><TextBlock Grid.Column="1" Text="Inventario de productos" FontSize="28" FontWeight="Bold" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid><Grid ColumnDefinitions="400,*" ColumnSpacing="18"><Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Producción o ajuste" FontSize="20" FontWeight="Bold"/><TextBox Watermark="Fecha yyyy-MM-dd" Text="{Binding InventoryDateText}"/><ComboBox ItemsSource="{Binding InventoryProducts}" SelectedItem="{Binding SelectedInventoryProduct}" DisplayMemberBinding="{Binding Name}"/><ComboBox ItemsSource="{Binding AdjustmentTypes}" SelectedItem="{Binding SelectedAdjustmentType}" DisplayMemberBinding="{Binding Name}"/><TextBox Watermark="Cantidad (+ agrega, − descuenta)" Text="{Binding InventoryAdjustmentQuantity}"/><TextBox Watermark="Notas" Text="{Binding InventoryAdjustmentNotes}"/><Button Classes="primary" Content="Guardar movimiento" Command="{Binding SaveInventoryAdjustmentCommand}"/><Button Classes="secondary" Content="Actualizar día" Command="{Binding RefreshInventoryCommand}"/></StackPanel></Border><StackPanel Grid.Column="1" Spacing="18"><Border Background="White" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Existencias actuales" FontSize="20" FontWeight="Bold"/><ListBox ItemsSource="{Binding InventoryProducts}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Foreground="#667085"/><TextBlock Text="{Binding LowStockThreshold, StringFormat='Alerta: {0}'}" FontSize="12"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StockQuantity}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border><Border Background="White" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Movimientos del día" FontSize="20" FontWeight="Bold"/><ListBox ItemsSource="{Binding InventoryMovements}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Type}" Foreground="#667085"/><TextBlock Text="{Binding Notes}" FontSize="12" Foreground="#667085"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding QuantityDelta}" FontWeight="Bold" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></StackPanel></Grid></StackPanel></ScrollViewer>
     <ScrollViewer IsVisible="{Binding IsAdminMetrics}"><StackPanel Spacing="16" MaxWidth="1120"><Grid ColumnDefinitions="Auto,*"><Button Classes="secondary" Content="← Panel" Command="{Binding CloseAdminMetricsCommand}"/><TextBlock Grid.Column="1" Text="Métricas y análisis" FontSize="28" FontWeight="Bold" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid><Grid ColumnDefinitions="180,180,Auto" ColumnSpacing="8"><TextBox Watermark="Desde yyyy-MM-dd" Text="{Binding MetricsFromText}"/><TextBox Grid.Column="1" Watermark="Hasta yyyy-MM-dd" Text="{Binding MetricsToText}"/><Button Grid.Column="2" Classes="primary" Content="Actualizar" Command="{Binding RefreshMetricsCommand}"/></Grid><Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12"><Border Background="White" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="Órdenes"/><TextBlock Text="{Binding Metrics.Orders}" FontSize="26" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="Ventas netas"/><TextBlock Text="{Binding Metrics.NetSales, StringFormat='MXN {0:N2}'}" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="2" Background="White" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="Periodo previo"/><TextBlock Text="{Binding Metrics.Comparison.PreviousNetSales, StringFormat='MXN {0:N2}'}" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="3" Background="White" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="Variación ventas"/><TextBlock Text="{Binding Metrics.Comparison.NetSalesChange, StringFormat='MXN {0:N2}'}" FontSize="22" FontWeight="Bold"/></StackPanel></Border></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="18"><Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="8"><TextBlock Text="Productos más vendidos" FontSize="20" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Metrics.TopProducts}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}"/><TextBlock Grid.Column="2" Text="{Binding Sales, StringFormat='MXN {0:N2}'}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="8"><TextBlock Text="Categorías: mayor a menor venta" FontSize="20" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Metrics.TopCategories}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Category}"/><TextBlock Grid.Column="1" Text="{Binding Sales, StringFormat='MXN {0:N2}'}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Categorías: menor a mayor venta" FontSize="20" FontWeight="Bold" Margin="0,12,0,0"/><ItemsControl ItemsSource="{Binding Metrics.BottomCategories}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Category}"/><TextBlock Grid.Column="1" Text="{Binding Sales, StringFormat='MXN {0:N2}'}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="18"><Border Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="8"><TextBlock Text="Alertas de existencias bajas" FontSize="20" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Metrics.LowStockAlerts}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding StockQuantity, StringFormat='Existencia: {0}'}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20"><StackPanel Spacing="8"><TextBlock Text="Señales de inventario" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding Metrics.StockSignals.Produced, StringFormat='Producido: {0}'}"/><TextBlock Text="{Binding Metrics.StockSignals.Adjusted, StringFormat='Ajustes netos: {0}'}"/><TextBlock Text="{Binding Metrics.StockSignals.Consumed, StringFormat='Consumido en ventas: {0}'}"/><TextBlock Text="{Binding Metrics.StockSignals.Restored, StringFormat='Devuelto por cancelaciones: {0}'}"/></StackPanel></Border></Grid></StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,30,16" Background="#1F2933" CornerRadius="8" Padding="14,8"><TextBlock Text="{Binding StatusMessage}" Foreground="White"/></Border>
 </Grid>
</Window>
