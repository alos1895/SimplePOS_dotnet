<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CafePOS.Desktop.ViewModels" x:Class="CafePOS.Desktop.Views.MainWindow" x:DataType="vm:MainViewModel" Title="CafePOS" Width="1366" Height="768" MinWidth="1100" MinHeight="650" WindowStartupLocation="CenterScreen">
 <Grid RowDefinitions="64,*,42" Background="#F5F2EC">
  <Border Background="#25352F" Padding="22,12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="CafePOS" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="Cajero" Foreground="White" VerticalAlignment="Center" FontSize="16"/></Grid></Border>
  <TabControl Grid.Row="1">
   <TabItem Header="Nueva orden">
    <Grid ColumnDefinitions="3*,2*" Margin="14">
     <ScrollViewer><ItemsControl ItemsSource="{Binding Products}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Classes="pos" Width="190" Height="92" Command="{Binding $parent[Window].DataContext.AddProductCommand}" CommandParameter="{Binding}"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" Foreground="#42765E"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="18" Margin="12,0,0,0"><Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
      <TextBlock Text="ORDEN ACTUAL" FontSize="21" FontWeight="Bold"/>
      <ListBox Grid.Row="1" ItemsSource="{Binding Cart}" Margin="0,12"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:CartLine"><Grid ColumnDefinitions="*,Auto,50,Auto"><StackPanel><TextBlock Text="{Binding Product.Name}" FontSize="17"/><TextBlock Text="{Binding Total, StringFormat='{}{0:C}'}"/></StackPanel><Button Grid.Column="1" Content="−" Command="{Binding $parent[Window].DataContext.DecrementCommand}" CommandParameter="{Binding}"/><TextBlock Grid.Column="2" Text="{Binding Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="3" Content="+" Command="{Binding $parent[Window].DataContext.IncrementCommand}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <TextBox Grid.Row="2" Watermark="Comentarios de la orden" Text="{Binding Comments}"/>
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12"><TextBlock Text="TOTAL" FontSize="24" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:C}'}" FontSize="28" FontWeight="Bold" Foreground="#247451"/></Grid>
      <StackPanel Grid.Row="4"><TextBox Watermark="Importe (vacío = saldo completo)" Text="{Binding PaymentAmount}"/><TextBox Watermark="Referencia de transferencia" Text="{Binding TransferReference}"/><Grid ColumnDefinitions="*,*"><Button Classes="pos" Content="COBRAR EFECTIVO" Command="{Binding PayCashCommand}" Background="#2F7D5A" Foreground="White"/><Button Grid.Column="1" Classes="pos" Content="TRANSFERENCIA" Command="{Binding PayTransferCommand}"/></Grid></StackPanel>
     </Grid></Border>
    </Grid>
   </TabItem>
   <TabItem Header="Historial"><Grid Margin="20" RowDefinitions="Auto,*"><Button Content="Actualizar" Command="{Binding RefreshHistoryCommand}" HorizontalAlignment="Left"/><DataGrid Grid.Row="1" ItemsSource="{Binding History}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding DailyNumber}"/><DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt}" Width="2*"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:C}'}"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}"/><DataGridTextColumn Header="Pagos" Binding="{Binding PaidAmount, StringFormat='{}{0:C}'}"/><DataGridTextColumn Header="Comentarios" Binding="{Binding Comments}" Width="3*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Caja"><StackPanel Margin="30" Spacing="12" MaxWidth="700"><TextBlock Text="CAJA" FontSize="26" FontWeight="Bold"/><TextBlock Text="{Binding CurrentSession.Status, FallbackValue='Cerrada'}"/><TextBlock Text="{Binding ExpectedCash, StringFormat='Balance esperado: {0:C}'}" FontSize="22"/><TextBox Watermark="Fondo inicial" Text="{Binding OpeningAmount}"/><Button Content="Abrir caja" Command="{Binding OpenCashCommand}"/><Separator/><TextBox Watermark="Concepto" Text="{Binding MovementConcept}"/><TextBox Watermark="Importe" Text="{Binding MovementAmount}"/><Grid ColumnDefinitions="*,*"><Button Content="Registrar ingreso" Command="{Binding AddIncomeCommand}"/><Button Grid.Column="1" Content="Registrar retiro" Command="{Binding AddExpenseCommand}"/></Grid><Separator/><TextBox Watermark="Efectivo contado" Text="{Binding CountedAmount}"/><Button Content="Hacer corte y cerrar" Command="{Binding CloseCashCommand}"/></StackPanel></TabItem>
   <TabItem Header="Ajustes"><StackPanel Margin="30" Spacing="12"><TextBlock Text="Mantenimiento" FontSize="26"/><Button Content="Crear backup manual" Command="{Binding BackupCommand}" HorizontalAlignment="Left" Padding="22,12"/><TextBlock Text="La configuración persistente se encuentra fuera del directorio de instalación."/></StackPanel></TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="#E4DED2" Padding="14,8"><TextBlock Text="{Binding StatusMessage}"/></Border>
 </Grid>
</Window>
